# Environment
.env
.env.backup.*

# Site-local Moodle/plugin manifest — copy moodle-config.example.json and edit.
moodle-config.json

# Local prod-test override (Garage; not for real deploys)
compose/docker-compose.prodtest.yml

# Build output (generated by build.sh)
moodle_app/
scratch/

# Moodle data
moodledata/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# PHP/Composer
vendor/
composer.lock

# Deliberately vendored Moodle plugins with no public upstream
!vendor/
# ...but never the node toolchain pulled into a vendored plugin during dev
vendor/**/node_modules/

# Site-local compose override (not for commit)
compose/docker-compose.local.yml
