<?php  // Moodle configuration file

unset($CFG);
global $CFG;
$CFG = new stdClass();

$CFG->dbtype    = getenv('DB_TYPE') ?: 'pgsql';
$CFG->dblibrary = 'native';
$CFG->dbhost    = getenv('DB_HOST') ?: 'postgres';
$CFG->dbname    = getenv('DB_NAME') ?: 'moodle';
$CFG->dbuser    = getenv('DB_USER') ?: 'moodleuser';
$CFG->dbpass    = getenv('DB_PASSWORD') ?: 'moodlepass';
$CFG->prefix    = getenv('DB_PREFIX') ?: 'mdl_';
$CFG->dboptions = array (
  'dbpersist' => 0,
  'dbport' => getenv('DB_PORT') ?: ($CFG->dbtype === 'pgsql' ? '5432' : '3306'),
  'dbsocket' => '',
  'dbcollation' => 'utf8mb4_unicode_ci',
);

// wwwroot is constructed in entrypoint.sh from MOODLE_PROTOCOL, MOODLE_HOST, and MOODLE_PORT
// or can be set explicitly via MOODLE_WWWROOT environment variable
$CFG->wwwroot   = getenv('MOODLE_WWWROOT') ?: 'http://localhost:8080';
$CFG->dataroot  = getenv('MOODLE_DATAROOT') ?: '/var/www/moodledata';
$CFG->admin     = 'admin';

$CFG->directorypermissions = 0777;

// Hand file downloads off to nginx (see /dataroot/ internal location in nginx configs).
$CFG->xsendfile = 'X-Accel-Redirect';
$CFG->xsendfilealiases = [
    '/dataroot/' => $CFG->dataroot,
];

// Lock admin-editable executable paths to what the image actually ships.
$CFG->preventexecpath = true;
$CFG->pathtophp       = '/usr/local/bin/php';
$CFG->pathtogs        = '/usr/bin/gs';
$CFG->pathtopdftoppm  = '/usr/bin/pdftoppm';
$CFG->pathtodu        = '/usr/bin/du';
$CFG->aspellpath      = '/usr/bin/aspell';
$CFG->pathtopython    = '/usr/bin/python3';

// Cap concurrent heavy tasks so cron can't saturate a single replica.
$CFG->task_concurrency_limit = [
    'core\task\course_backup_task' => 1,
    'core_course\task\course_delete_modules' => 10,
    'assignfeedback_editpdf\task\convert_submission' => 3,
];

// Performance settings
$CFG->cachedir = $CFG->dataroot . '/cache';
$CFG->localcachedir = '/tmp/moodle_localcache';  // Container-local (not shared across replicas)
$CFG->tempdir = $CFG->dataroot . '/temp';
$CFG->cachejs = true;

// Redis session handler (scales across PHP-FPM replicas without file lock contention)
$CFG->session_handler_class = '\core\session\redis';
$CFG->session_redis_host = getenv('REDIS_HOST') ?: 'redis';
$CFG->session_redis_port = (int)(getenv('REDIS_PORT') ?: 6379);
$CFG->session_redis_prefix = 'moodle_sess_';
$CFG->session_redis_acquire_lock_timeout = 120;
$CFG->session_redis_lock_expire = 7200;

// Skip session write locks on read-only pages (big concurrency win with Redis sessions).
// Disabled until session-mapped caches are migrated off the session store.
// $CFG->enable_read_only_sessions = true;

// Redis cache store for MUC (application and session caches)
$CFG->forced_plugin_settings['cachestore_redis'] = [
    'server' => (getenv('REDIS_HOST') ?: 'redis') . ':' . (getenv('REDIS_PORT') ?: '6379'),
    'prefix' => 'moodle_muc_',
    'compressor' => 1,  // gzip compression
];

// Debugging - set via environment variable
$debug = getenv('MOODLE_DEBUG');
if ($debug === 'true' || $debug === '1') {
    @error_reporting(E_ALL | E_STRICT);
    @ini_set('display_errors', '1');
    $CFG->debug = (E_ALL | E_STRICT);
    $CFG->debugdisplay = 1;
} else {
    @error_reporting(E_ALL | E_STRICT);
    @ini_set('display_errors', '0');
    $CFG->debug = 0;
    $CFG->debugdisplay = 0;
}

// Email settings (optional)
if (getenv('MOODLE_MAIL_NOREPLY')) {
    $CFG->noreplyaddress = getenv('MOODLE_MAIL_NOREPLY');
}
if (getenv('MOODLE_MAIL_PREFIX')) {
    $CFG->mailprefix = getenv('MOODLE_MAIL_PREFIX');
}

// Reverse proxy settings (if behind a proxy)
if (getenv('MOODLE_REVERSEPROXY') === 'true') {
    $CFG->reverseproxy = true;
}

// SSL proxy setting (when SSL is terminated by upstream proxy like Traefik/nginx)
if (getenv('MOODLE_SSLPROXY') === 'true') {
    $CFG->sslproxy = true;
    $_SERVER['HTTPS'] = 'on';
}

// Accelerate category / deep-course pages; must be defined before setup.php.
define('CONTEXT_CACHE_MAX_SIZE', 20000);

require_once(__DIR__ . '/lib/setup.php');

// There is no php closing tag in this file,
// it is intentional because it prevents trailing whitespace problems!
