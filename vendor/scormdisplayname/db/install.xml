<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/scormdisplayname/db" VERSION="20260513" COMMENT="local_scormdisplayname schema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_scormdisplayname" COMMENT="Stores the full activity-page title for SCORM activities whose section-page label has been overridden via this plugin">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="scormid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="FK to mdl_scorm.id"/>
        <FIELD NAME="fulltitle" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="The longer title shown on the SCORM activity page"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_scormid" TYPE="foreign-unique" FIELDS="scormid" REFTABLE="scorm" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>
