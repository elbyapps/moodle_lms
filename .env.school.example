# School LMS instance — environment configuration
# Copy to .env on the school box and set the values marked  <<<.
# Self-contained single-box deployment: local MariaDB, local-filesystem
# moodledata (no S3), webservices-only link to central.

# =============================================================================
# IMAGE VERSION (GHCR)
# =============================================================================
# Use rtb for smoke tests / tracking, or pin production schools to an immutable
# sha-<shortsha> tag after validating that image.
IMAGE_TAG=rtb

# =============================================================================
# DATABASE (local, bundled mariadb container)
# =============================================================================
DB_TYPE=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=moodle
DB_USER=moodleuser
DB_PASSWORD=change-me-db            # <<< set a strong password
DB_ROOT_PASSWORD=change-me-root     # <<< set a strong password
DB_PREFIX=mdl_

# =============================================================================
# MOODLE SITE
# =============================================================================
# The school's URL. On a LAN-only box this is the eth0 IP or an internal DNS
# name. Switch to https once TLS is wired at nginx.
MOODLE_WWWROOT=http://192.168.18.39          # <<< school URL / LAN IP
MOODLE_PORT=80
MOODLE_DEBUG=false
MOODLE_MAIL_NOREPLY=noreply@rtb.gov.rw
MOODLE_MAIL_PREFIX=[RTB eLearning]
# Set both true only when an in-container TLS vhost terminates HTTPS;
# an HTTP-only LAN box leaves them false.
MOODLE_REVERSEPROXY=false
MOODLE_SSLPROXY=false

# First-run admin / site identity
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=change-me-admin            # <<< set a strong password
MOODLE_ADMIN_EMAIL=admin@rtb.gov.rw
MOODLE_SITE_FULLNAME=RTB eLearning — <School Name>   # <<< school name
MOODLE_SITE_SHORTNAME=<school-code>                  # <<< school code

# =============================================================================
# FILE STORAGE — local filesystem only (no S3 / objectfs on school instances)
# =============================================================================
FILESTORAGE_BACKEND=local

# =============================================================================
# CENTRAL INTEGRATION (Moodle webservices / REST — no Tailscale tunnel)
# =============================================================================
# SDMS / roster-sync endpoint on central. The school proxies TDMP through
# central and never holds the TDMP key.
SDMS_URL=http://10.32.2.16:8082/sdms/api/REB_API   # <<< central webservice URL

# =============================================================================
# SIZING — 2 vCPU / 16 GB VM (host is the lab domain controller)
# =============================================================================
SERVER_CPUS=2
SERVER_MEMORY_GB=16
PHP_REPLICAS=1
CPUS_PER_REPLICA=1
PHP_WORKER_MEMORY_MB=128
PHP_MEMORY_FRACTION=0.6
PHP_PM_MODE=ondemand
PHP_REPLICA_MEMORY=8G
OPCACHE_MEMORY_MB=256
OPCACHE_JIT_BUFFER_MB=128
OPCACHE_INTERNED_STRINGS_MB=64

# =============================================================================
# REDIS (bundled)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# BACKUP (DB dump + local moodledata tar to off-box storage)
# =============================================================================
BACKUP_RETENTION_DAYS=30
