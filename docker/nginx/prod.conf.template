# Docker DNS resolver for replica discovery
resolver 127.0.0.11 valid=10s ipv6=off;

# NOTE: FastCGI caching removed — Moodle responses are user-specific (CSRF tokens,
# language, permissions) and the MoodleSession cookie is set on the first request,
# so bypass-on-cookie misses only a narrow window of robot traffic anyway.
# Relying on OPcache + Moodle MUC (Redis) for performance instead.

# Rate limiting for login endpoints (credential stuffing / brute force).
# Only scoped to /login/ because many REB schools sit behind NAT — a per-IP cap
# on general PHP traffic would throttle entire classrooms during quiz submissions.
# Pairs with the moodle-auth_antihammer plugin (app-level lockout).
limit_req_zone $binary_remote_addr zone=login:10m rate=5r/s;
limit_req_status 429;
limit_req_log_level warn;

# SSL is terminated upstream by an external reverse proxy. This vhost speaks
# plain HTTP; it must only be exposed through that proxy (or a local test).
server {
    listen 80;
    server_name _;

    root /var/www/html/moodle_app/public;
    index index.php index.html;

    client_max_body_size 600M;

    error_log /var/log/nginx/error.log warn;

    # Security headers. HSTS is deliberately omitted — set it on the external
    # proxy that terminates TLS, so it can't leak into an environment without SSL.
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml
        font/woff
        font/woff2;

    location / {
        try_files $uri $uri/index.php =404;
    }

    # Rate-limited login endpoints. Matched BEFORE the catch-all PHP regex.
    location ~ ^/login/(index|signup|forgot_password|confirm)\.php$ {
        limit_req zone=login burst=20 nodelay;

        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        set $php_upstream php;
        fastcgi_pass $php_upstream:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTP_HOST $http_host;
        fastcgi_param SERVER_PORT ${MOODLE_PORT};
        fastcgi_read_timeout 300;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    location ~ [^/]\.php(/|$) {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;

        # Variable-based upstream forces DNS re-resolution per request,
        # round-robining across all PHP-FPM replicas automatically.
        set $php_upstream php;
        fastcgi_pass $php_upstream:9000;

        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_param HTTP_HOST $http_host;
        fastcgi_param SERVER_PORT ${MOODLE_PORT};
        fastcgi_read_timeout 300;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    # Static asset caching (after PHP block so pluginfile.php URLs are handled by PHP first)
    location ~* \.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        try_files $uri =404;
        expires 7d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location /api/sdms/ {
        proxy_pass ${SDMS_URL};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Block access to sensitive files
    location ~ /\.git {
        deny all;
        return 404;
    }

    location ~ /\.env {
        deny all;
        return 404;
    }

    location ~ /config\.php$ {
        deny all;
        return 404;
    }

    location ~ /version\.php$ {
        deny all;
        return 404;
    }

    location ~ /\.ht {
        deny all;
    }

    location /dataroot/ {
        internal;
        alias /var/www/moodledata/;
    }
}
