# Moodle Environment Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Choose your database type: mariadb or pgsql
DB_TYPE=mariadb
DB_HOST=mariadb
DB_PORT=3306

# Database credentials
DB_NAME=moodle
DB_USER=moodleuser
DB_PASSWORD=moodlepass
DB_ROOT_PASSWORD=rootpass

# Database table prefix
DB_PREFIX=mdl_

# =============================================================================
# MOODLE CONFIGURATION
# =============================================================================
# Moodle site URL components
MOODLE_PROTOCOL=http
MOODLE_HOST=localhost
MOODLE_PORT=8080

# Alternatively, set MOODLE_WWWROOT directly (overrides the above)
MOODLE_WWWROOT=http://localhost:8080

# Moodle settings
MOODLE_DEBUG=false
MOODLE_MAIL_NOREPLY=noreply@example.com
MOODLE_MAIL_PREFIX=[Moodle]
MOODLE_REVERSEPROXY=false
MOODLE_SSLPROXY=false

# =============================================================================
# MOODLE ADMIN / SITE CONFIGURATION (auto-install)
# =============================================================================
# These are used for automatic database installation on first run
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=Admin123!
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_SITE_FULLNAME=Moodle Dev
MOODLE_SITE_SHORTNAME=moodle
